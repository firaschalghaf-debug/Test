// Secrets.xcconfig.template
// ──────────────────────────────────────────────────────────────────────
// 1. Copy this file:  cp Secrets.xcconfig.template Secrets.xcconfig
// 2. Fill in your values below.
// 3. Secrets.xcconfig is in .gitignore — it NEVER gets committed.
// 4. In Xcode: Project → Info → Configurations → point each config to Secrets.xcconfig
// 5. In Info.plist add keys that read these values, e.g.:
//      SUPABASE_URL  = $(SUPABASE_URL)
// 6. In AppConfig.swift read via Bundle.main.infoDictionary["SUPABASE_URL"]
// ──────────────────────────────────────────────────────────────────────

SUPABASE_URL = https://your-project-ref.supabase.co
SUPABASE_KEY = your_publishable_key_here
ADMIN_EMAIL  = your_admin@example.com
